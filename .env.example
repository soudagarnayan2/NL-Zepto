# =========================================================================
# Ask Zepto AI — Environment Variables
# Copy this file to .env and fill in your real values.
# =========================================================================

# ── Zepto Catalog API ──────────────────────────────────────────────────────
# Base URL for Zepto's product catalog REST API (no trailing slash)
ZEPTO_API_BASE=https://api.zepto.example/v1

# Bearer token for authenticating against the Zepto catalog API
ZEPTO_API_KEY=your_zepto_api_key_here

# ── Anthropic / Claude ────────────────────────────────────────────────────
# API key for the Anthropic Claude model used by the agent orchestrator
ANTHROPIC_API_KEY=your_anthropic_api_key_here
